play.http.secret.key="REPLACE_WITH_A_RANDOM_64_CHAR_SECRET_KEY"
search.uri="http://thehive-elasticsearch:9200"
job.directory="/tmp/cortex-jobs"
analyzer.urls=["https://download.thehive-project.org/analyzers.json"]
responder.urls=["https://download.thehive-project.org/responders.json"]

analyzer {
  urls = [
    "/opt/Cortex-Analyzers/analyzers"
  ]
}
responder {
  urls = [
    "/opt/Cortex-Analyzers/responders"
  ]
}
